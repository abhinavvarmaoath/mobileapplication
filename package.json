{
  "name": "easy-grader",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile web front end for a course grading app",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run lint:html && npm run check:vendor && npm run check:csp && npm run scan:secrets && npm test",
    "lint:html": "node tools/check-html.mjs",
    "check:vendor": "node tools/check-vendor.mjs",
    "csp": "node tools/csp.mjs",
    "check:csp": "node tools/csp.mjs --check",
    "scan:secrets": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^22.20.5",
    "html-validate": "^11.17.0",
    "secretlint": "^13.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
