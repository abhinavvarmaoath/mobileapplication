{
  "name": "easy-grader",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile web front end for a course grading app",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run lint:html && npm test",
    "lint:html": "node tools/check-html.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "html-validate": "^11.17.0",
    "typescript": "^7.0.2"
  }
}
